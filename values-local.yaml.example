# Local configuration for ogx-showroom
#
# Copy this file and fill in your values:
#   cp values-local.yaml.example values-local.yaml
#
# This file is used by:
#   - provision.sh (ogx section, passed via -f to Helm)
#   - setup.sh (cluster section)
#   - deploy-local.sh (devLocal section)
#   - test.sh, demos (model names, openaiApiKey)
#
# values-local.yaml is gitignored — do not commit it.

# ============================================================
# OGX Helm values (consumed by charts/ogx-rhoai)
# ============================================================
# Keys under "ogx:" are passed to the Helm chart and injected
# into the OGX pod as env vars. Any value that the OGX server
# needs at runtime MUST go here — including API keys, auth
# settings, provider config, and resource limits.
# See charts/ogx-rhoai/values.yaml for the full list.
ogx:
  inference:
    model: Qwen2.5-VL-7B-Instruct
    vllmUrl: ""              # REQUIRED: e.g. https://litemaas.rhoai.rh-aiservices-bu.com/v1
    vllmApiToken: ""         # REQUIRED: your inference API token

  embedding:
    model: Nomic-embed-text-v2-moe
    providerModelId: Nomic-embed-text-v2-moe
    dimension: "768"
    vllmUrl: ""              # REQUIRED: e.g. https://litemaas.rhoai.rh-aiservices-bu.com/v1
    vllmApiToken: ""         # REQUIRED: your embedding API token

  # OpenAI API key (for multi-agent demo - passed to OGX server)
  openaiApiKey: ""

  # Telemetry: enable OTEL metrics and traces export to the collector.
  # Metrics: OTEL Collector -> Prometheus -> Grafana
  # Traces: OTEL Collector -> Jaeger
  # Grafana admin password is auto-generated in the grafana-secret K8s secret:
  #   oc get secret grafana-secret -o jsonpath='{.data.GRAFANA_ADMIN_PASSWORD}' | base64 -d
  # Dashboard: /d/ogx-overview/ogx-overview on the Grafana route
  # Jaeger UI: access via port-forward (oc port-forward svc/jaeger 16686:16686)
  telemetry:
    enabled: true
    otlpEndpoint: "http://otel-collector:4318"

# ============================================================
# Cluster setup (used by setup-cluster.sh)
# ============================================================
cluster:
  # REQUIRED: base64-encoded quay.io credentials
  # To generate:
  #   1. Go to quay.io -> Account Settings -> CLI Password -> Generate Encrypted Password
  #   2. Run: podman login --authfile /tmp/ps.json -u='<user>' -p='<pass>' quay.io
  #   3. Extract: cat /tmp/ps.json | jq -r '.auths["quay.io"].auth'
  pullSecret: ""

  # Optional overrides (defaults are usually fine)
  catalogImage: ""           # default: quay.io/rhoai/rhoai-fbc-fragment:rhoai-3.5-ea.1
  operatorChannel: ""        # default: beta
  ogxImage: ""               # custom OGX image (for testing)
  operatorImage: ""          # custom operator image (for testing)

# ============================================================
# Local dev deployment (used by deploy-local.sh)
# ============================================================
devLocal:
  ogxSourcePath: ""          # e.g. ~/projects/ogx
  imageNamespace: ""         # default: redhat-ods-applications
  imageName: ""              # default: ogx-dev
  imageTag: ""               # default: auto-generated with timestamp
  baseImage: ""              # default: auto-detected from operator
  containerTool: ""          # default: podman
